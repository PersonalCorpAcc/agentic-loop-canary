{
  "name": "loopscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A live view of what the agentic loop is doing: routes, outcomes, pull requests and cost, read from the repository that runs it.",
  "scripts": {
    "dev": "concurrently -k \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "start": "tsx src/server/main.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.18.3",
    "tsx": "4.20.6",
    "react-router-dom": "6.30.1",
    "@mui/material": "6.5.0",
    "@mui/system": "6.5.0",
    "@mui/icons-material": "6.5.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@10.30.3"
}
